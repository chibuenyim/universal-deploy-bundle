#!/bin/bash

# V4.1.3 Pre-Push Hook
# Runs comprehensive scan before pushing to remote
# More thorough than pre-commit - catches anything that might have slipped through

echo "🚀 Running V4.1.3 Pre-Push Scan..."

# Get script directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Run the scanner on all commits in this push
node "$SCRIPT_DIR/pre-commit-scan.js"

# Check exit code
SCAN_EXIT_CODE=$?

if [ $SCAN_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ Pre-push scan failed. Push blocked."
  echo ""
  echo "To bypass this check (NOT RECOMMENDED):"
  echo "  git push --no-verify"
  echo ""
  exit 1
fi

# Success - allow push
echo "✅ Pre-push scan passed. Proceeding with push..."
exit 0
