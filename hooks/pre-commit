#!/bin/bash

# V4.1.3 Pre-Commit Hook
# Automatically runs code scanner before allowing commit
# Blocks commits with critical errors (credentials, build errors)

echo "🔍 Running V4.1.3 Pre-Commit Scan..."

# Get script directory
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Run the scanner
node "$SCRIPT_DIR/pre-commit-scan.js"

# Check exit code
SCAN_EXIT_CODE=$?

if [ $SCAN_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ Pre-commit scan failed. Commit blocked."
  echo ""
  echo "To bypass this check (NOT RECOMMENDED):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi

# Success - allow commit
exit 0
