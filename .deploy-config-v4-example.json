{
  "sshHost": "root@your-server.com",
  "remotePath": "/var/www/html/your-app",
  "branch": "master",
  "url": "https://your-app.com",
  "frontendPort": 3000,
  "backendPort": 3020,
  "environment": "production",
  "features": {
    "forceContinue": true,
    "strictTwelveFactor": true,
    "zeroErrorDetection": true
  },
  "twelveFactor": {
    "config": {
      "comment": "All config should be in environment variables, not in this file",
      "requiredEnvVars": [
        "DATABASE_URL",
        "JWT_SECRET",
        "NODE_ENV"
      ]
    },
    "logs": {
      "comment": "Logs should go to stdout/stderr, handled by execution environment (PM2)",
      "pm2Config": {
        "error_file": "/dev/stderr",
        "out_file": "/dev/stdout",
        "log_date_format": "YYYY-MM-DD HH:mm:ss Z"
      }
    },
    "backingServices": {
      "comment": "All services accessed via connection URLs in environment",
      "exampleEnvVars": [
        "DATABASE_URL=postgresql://user:pass@host:5432/db",
        "REDIS_URL=redis://localhost:6379",
        "SMTP_URL=smtp://user:pass@smtp.example.com:587"
      ]
    }
  },
  "deploymentStages": {
    "comment": "V4 tracks all stages and can resume from any point",
    "stages": [
      "INIT",
      "AUTO_CONFIGURE",
      "PULL_CODE",
      "BUILD_BACKEND",
      "BUILD_FRONTEND",
      "RESTART_SERVICES",
      "VERIFY",
      "HEALTH_CHECK",
      "COMPLETE"
    ]
  },
  "errorHandling": {
    "comment": "V4 automatically recovers from most errors",
    "autoRecovery": {
      "enabled": true,
      "maxAttempts": 3,
      "categories": [
        "BUILD",
        "DEPENDENCY",
        "NETWORK",
        "PROCESS"
      ]
    },
    "manualResolution": {
      "categories": [
        "CONFIG",
        "PERMISSION",
        "TWELVE_FACTOR"
      ],
      "comment": "These errors require manual intervention with context provided"
    }
  },
  "statePersistence": {
    "comment": "Deployment state is saved and can be resumed",
    "stateFile": ".deployment-state-v4.json",
    "autoSave": true,
    "resumeCapability": true
  },
  "reporting": {
    "comment": "V4 generates comprehensive deployment reports",
    "includeErrors": true,
    "includeViolations": true,
    "includeWarnings": true,
    "includeCheckpoints": true
  }
}
